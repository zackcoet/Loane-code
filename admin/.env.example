# Loane admin dashboard configuration.
# Copy to `.env`. NEVER commit `.env`.

# true = local Firebase Emulator Suite. false = the real project below.
VITE_USE_EMULATORS=true
VITE_EMULATOR_HOST=127.0.0.1

# Firebase web config — the same web app as the mobile client.
# Not a secret: it identifies the project, the security rules grant access.
VITE_FIREBASE_API_KEY=demo-api-key
VITE_FIREBASE_AUTH_DOMAIN=demo-loane.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-loane
VITE_FIREBASE_STORAGE_BUCKET=demo-loane.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000
