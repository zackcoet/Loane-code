# Cloud Functions environment.
# Copy to .env for local emulator runs. NEVER commit .env.

# Which Firebase project the emulator pretends to be.
GCLOUD_PROJECT=demo-loane

# Local-only password for Zack's seeded admin account.
# Put the real value in backend/functions/.env, never in this file.
SEED_ADMIN_PASSWORD=replace-with-local-password

# --- Phase 5: Stripe. Leave blank until payments are built. ---
# Secret key. This is a real secret — it never goes in the repo, and in
# production it lives in Cloud Functions config, not here.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- AI try-on: FASHN ---
# Photographs of students' bodies go to this service, so the key is a real
# secret: it never goes in the repo and in production it lives in Cloud
# Functions secrets, not here.
#
#   firebase functions:secrets:set FASHN_API_KEY --project loane-code
#
# For the local emulator, copy the FASHN_API_KEY line from .env.tryon into
# .env (both are gitignored). Nothing reaches FASHN from the emulator
# unless you generate a try-on, and every generation costs $0.075.
FASHN_API_KEY=
