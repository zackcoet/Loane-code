rules_version = '2';

// Loane Firestore security rules.
//
// The guiding rule: NEVER TRUST THE PHONE.
//
// A user may write her own profile, listings, posts and messages. Everything
// that involves money, trust, verification or counting is writable only by
// Cloud Functions (which use the Admin SDK and bypass these rules entirely).
//
// See docs/security.md for the reasoning behind each block.

service cloud.firestore {
  match /databases/{database}/documents {

    // -----------------------------------------------------------------
    // Helpers
    // -----------------------------------------------------------------

    function signedIn() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    function isSelf(userId) {
      return signedIn() && uid() == userId;
    }

    // Admin is a custom claim set by the server, never a database field —
    // a field is something someone might find a way to write.
    function isAdmin() {
      return signedIn() && request.auth.token.admin == true;
    }

    function existingUser() {
      return get(/databases/$(database)/documents/users/$(uid())).data;
    }

    // Is this account in good standing? Suspended users can read but not act.
    function isActive() {
      return signedIn() && existingUser().status == 'active';
    }

    // Campus-verified AND active. Today isVerified is set from the email
    // domain alone (see docs/security.md) — the check is wired up now so
    // that turning on real verification changes nothing here.
    function isVerifiedStudent() {
      return isActive() && existingUser().isVerified == true;
    }

    // Which fields is this write touching?
    function changed() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    // True when a write only touches fields from the allowed list.
    function onlyChanges(allowed) {
      return changed().hasOnly(allowed);
    }

    // -----------------------------------------------------------------
    // campuses — the approved-school list
    // -----------------------------------------------------------------
    match /campuses/{campusId} {
      // Readable by anyone, including signed-out users: the signup screen
      // needs the approved domain list before an account exists.
      allow read: if true;
      // Written only by Cloud Functions / admins.
      allow write: if false;
    }

    // -----------------------------------------------------------------
    // legalDocs — published legal versions
    // -----------------------------------------------------------------
    match /legalDocs/{docId} {
      // Public because signup, App Store review and joinloane.com all need
      // Terms and Privacy before someone has an account.
      allow read: if true;
      // Published legal versions are immutable and written only by Cloud
      // Functions. Never overwrite an old version.
      allow write: if false;
    }

    // Drafts are only for the admin dashboard and are still written through
    // Cloud Functions, so every publish has an audit row.
    match /legalDrafts/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // -----------------------------------------------------------------
    // users — public profile
    // -----------------------------------------------------------------
    match /users/{userId} {
      allow read: if signedIn();

      // The user profile document is created by a Cloud Function during
      // signup, never by the app — it has to set campusId and isVerified.
      allow create: if false;

      // She may edit a narrow set of her own fields and nothing else.
      //
      // This is an ALLOW-LIST: anything not named here is refused, so a
      // field added to the User type later is locked by default until we
      // deliberately open it.
      //
      // Deliberately absent, and each for a reason:
      //   username        — a handle is a lock; changeUsername owns it
      //   campusId        — she cannot move herself to another school
      //   campusEmail     — moved to private/settings entirely; it was
      //                     readable by every signed-in student
      //   isVerified      — otherwise "verified student" means nothing
      //   emailConfirmed  — only a real confirmation may set this
      //   role, status    — nobody promotes or un-suspends themselves
      //   stats           — every counter is a Cloud Function's job
      //   legalAccepted   — acceptLegalDocs checks the version she claims
      //                     against the published one before writing it
      //   isFoundingCloset, stripe, verifiedAt, createdAt
      allow update: if isSelf(userId)
        && isActive()
        && onlyChanges([
             'firstName',
             'displayName',
             'bio',
             'photoUrl',
             'sizes',
             'showSizes',
             'pushTokens',
             'lastActiveAt',
             'updatedAt'
           ]);

      allow delete: if false;

      // Private settings: only hers, only ever read by her or an admin.
      //
      // She may change her phone, her handoff notes and her notification
      // preferences. She may NOT touch campusEmail or accountEmail: her
      // claim to be a student at this school rests on that address, and
      // letting her rewrite it here would undo the whole point of
      // checking the domain at signup. Those are written once, by
      // createAccount.
      match /private/{docId} {
        allow read: if isSelf(userId) || isAdmin();
        allow create: if false;
        allow update: if isSelf(userId)
          && isActive()
          && onlyChanges([
               'phone',
               'handoffNotes',
               'notificationPreferences',
               // What her own "Complete your profile" card shows. Like
               // dismissedSuggestions below, it moves no counter and
               // grants nothing — it changes only what she is shown.
               'profileChecklist',
               // Whether she has seen the walkthrough. Hers to answer.
               'walkthrough',
               // Whether her phone says "Seen". It only ever withholds
               // something about her, so it is hers to switch.
               'messaging',
               'updatedAt'
             ]);
        allow delete: if false;
      }

      /**
       * Closets she dismissed from "suggested for you".
       *
       * THE APP MAY WRITE THIS, unlike almost everything else under
       * users/. It moves no counter, grants nothing, and changes only
       * what she herself is shown — which is the line "never trust the
       * phone" actually draws. Making her wait on a Cloud Function to
       * hide a card she just tapped X on would be slower for no gain.
       *
       * Only her own, only an empty marker: the document id IS the
       * data, so there is nothing to forge inside it.
       */
      match /dismissedSuggestions/{otherUid} {
        allow read: if isSelf(userId);
        allow create, delete: if isSelf(userId) && isActive();
        allow update: if false;
      }

      // Who she has blocked. Written only by blockUser, so the reverse
      // marker below can never drift out of step with it.
      match /blocked/{blockedUid} {
        allow read: if isSelf(userId);
        allow write: if false;
      }

      // Who has blocked HER.
      //
      // She can read it, which technically tells her she was blocked.
      // Her app needs it to hide him from her feed — without it,
      // blocking would only work one way in practice. Nothing in the UI
      // ever says "you were blocked"; her app just quietly filters.
      // The honest version of this trade-off is in docs/security.md.
      match /blockedBy/{blockerUid} {
        allow read: if isSelf(userId);
        allow write: if false;
      }

      // Private operational notes. She must never see these — half the
      // point of them is being able to write "watch this one" honestly.
      match /adminNotes/{noteId} {
        allow read: if isAdmin();
        allow write: if false;
      }

      // Activity feed. Written by Cloud Functions; she may only mark read.
      match /notifications/{notificationId} {
        allow read: if isSelf(userId);
        allow create, delete: if false;
        allow update: if isSelf(userId) && onlyChanges(['readAt', 'updatedAt']);
      }
    }

    // -----------------------------------------------------------------
    // usernames — uniqueness locks
    // -----------------------------------------------------------------
    match /usernames/{username} {
      // Readable so the claim-username screen can say "already taken"
      // before submitting.
      allow read: if true;
      // Claiming happens in a Cloud Function transaction alongside the
      // user document. Letting the app write here would let someone claim
      // a name without taking it.
      allow write: if false;
    }

    /**
     * phoneHashes/{hash} — "is this contact on Loane?"
     *
     * SEALED. Not readable, not writable, by anybody with a phone.
     *
     * Read access would hand a student a way to test whether a number
     * she has belongs to a Loane account, one guess at a time — which
     * is precisely the thing the peppered hash exists to prevent. The
     * only legitimate reader is matchContacts, which runs with admin
     * credentials and holds the pepper. The only legitimate writer is
     * the syncPhoneHash trigger.
     *
     * A document here is a claim that a number belongs to a uid. If
     * the app could write one, a student could point somebody else's
     * number at her own account and be matched by all of their friends.
     */
    /**
     * rateLimits/{id} — SEALED.
     *
     * If the app could read these it would know exactly how close
     * somebody is to a limit; if it could write them it could reset
     * its own counter, which is the whole limit gone. Only the
     * functions touch this, with admin credentials.
     */
    match /rateLimits/{id} {
      allow read: if false;
      allow write: if false;
    }

    /**
     * messageQuotas/{uid} — the hourly message ceiling.
     *
     * Messages are written by the app for speed, so their limit cannot
     * live in a function. Every message is batched with a write here,
     * and the message rule checks the counter moved by exactly one.
     * She may read her own (her phone needs it to know which write to
     * send) and nobody else's. She can never lower it: a fresh window
     * only opens once the server agrees an hour has passed.
     *
     * 500 MUST match LIMITS.messagesPerHour in shared/src/constants.ts.
     */
    match /messageQuotas/{ownerUid} {
      function isOwner() {
        return signedIn() && uid() == ownerUid;
      }
      function freshWindow() {
        return request.resource.data.keys().hasOnly(['windowStart', 'count'])
          && request.resource.data.windowStart == request.time
          && request.resource.data.count == 1;
      }

      allow read: if isOwner() || isAdmin();
      allow create: if isOwner() && freshWindow();
      allow update: if isOwner()
        && request.resource.data.keys().hasOnly(['windowStart', 'count'])
        && (
          // The same window, one more message, still under the ceiling.
          (request.resource.data.windowStart == resource.data.windowStart
            && request.resource.data.count == resource.data.count + 1
            && request.resource.data.count <= 500)
          // The hour is up: start again from one.
          || (request.time > resource.data.windowStart + duration.value(1, 'h')
            && freshWindow())
        );
      allow delete: if false;
    }

    match /phoneHashes/{hash} {
      allow read: if false;
      allow write: if false;
    }

    /**
     * tryOns/{tryOnId} — generated try-on images.
     *
     * HERS AND NOBODY ELSE'S. Not another student, not an admin.
     *
     * No admin read rule, deliberately. An admin has no business
     * looking at a photograph of a student's body, and the absence of
     * the rule is the control — "we would only look if we had to" is
     * not a control. If a damage claim ever needs one, that is a
     * conversation to have then, with her consent.
     *
     * She may flip `saved` and delete her own. Everything else is a
     * Cloud Function's job: the app cannot invent a try-on document,
     * which is what stops it pointing at an image it did not pay for.
     */
    match /tryOns/{tryOnId} {
      allow read: if isSelf(resource.data.uid);
      allow create: if false;
      allow update: if isSelf(resource.data.uid)
        && isActive()
        && onlyChanges(['saved', 'updatedAt']);
      allow delete: if isSelf(resource.data.uid);
    }

    /**
     * config/{docId} — runtime switches, e.g. whether try-on is on.
     *
     * Readable by any signed-in student so the app can hide a feature
     * without a deploy. Written only through an admin function, which
     * leaves an audit row — a switch that turns on spending should
     * never be flippable from a phone.
     */
    match /config/{docId} {
      allow read: if signedIn();
      allow write: if false;
    }

    // -----------------------------------------------------------------
    // listings — garments in closets
    //
    // These checks mirror `validateListingDraft` in shared/src/validation.ts.
    // The app's copy gives a friendly message; THIS copy is what makes it
    // true, because security rules cannot call TypeScript. If you change
    // one, change the other.
    // -----------------------------------------------------------------
    match /listings/{listingId} {
      function draft() {
        return request.resource.data;
      }

      function hasRequiredFields() {
        return draft().keys().hasAll([
                 'ownerUid', 'campusId', 'name', 'category', 'occasions',
                 'intent', 'status', 'photos', 'pricing', 'stats'
               ])
          && draft().name is string
          && draft().name.size() >= 2
          && draft().name.size() <= 80
          && draft().description is string
          && draft().description.size() <= 1000
          && draft().category in [
               'dresses','tops','bottoms','sets','outerwear',
               'shoes','bags','accessories','jewelry'
             ]
          && draft().occasions is list
          && draft().occasions.size() >= 1
          && draft().occasions.size() <= 8
          && draft().intent in ['rent', 'sell', 'both']
          && draft().photos is list
          && draft().photos.size() >= 1
          && draft().photos.size() <= 8;
      }

      /** A price, in whole cents, inside the allowed range. */
      function validPrice(cents) {
        return cents is int && cents >= 100 && cents <= 100000;
      }

      function pricingMatchesIntent() {
        return (
          // Rentable pieces need both durations priced and a documented
          // value — the value is what caps a damage claim later.
          !(draft().intent in ['rent', 'both'])
          || (validPrice(draft().pricing.threeDayCents)
              && validPrice(draft().pricing.sevenDayCents)
              && draft().garmentValueCents is int
              && draft().garmentValueCents >= 1000
              && draft().garmentValueCents <= 500000)
        ) && (
          !(draft().intent in ['sell', 'both']) || validPrice(draft().salePriceCents)
        );
      }

      function countersStartAtZero() {
        return draft().stats.viewCount == 0
          && draft().stats.saveCount == 0
          && draft().stats.tagCount == 0
          && draft().stats.completedRentals == 0;
      }

      allow read: if signedIn();

      allow create: if isVerifiedStudent()
        && draft().ownerUid == uid()
        && draft().campusId == existingUser().campusId
        // 'paused' belongs here as much as the other two. The form
        // writes it whenever "Available now" is off, and leaving it out
        // meant anyone who turned that toggle off got their listing
        // refused — with "check your connection", because the catch
        // below could not tell a permission error from a dropped one.
        // `update` has always allowed it; only `create` disagreed.
        && draft().status in ['draft', 'active', 'paused']
        && hasRequiredFields()
        && pricingMatchesIntent()
        // She does not get to invent a view count.
        && countersStartAtZero();

      allow update: if isActive()
        && resource.data.ownerUid == uid()
        // She cannot move a listing to another campus, change its owner,
        // write its counters, or un-suspend it after an admin took it down.
        && !changed().hasAny([
             'ownerUid', 'campusId', 'stats', 'suspendedReason',
             'createdAt', 'owner', 'removedAt',
             // Derived from the bookings by a Cloud Function. If the app
             // could write it, a lender could hide a booked weekend.
             'bookedDates'
           ])
        && draft().status in ['draft', 'active', 'paused']
        && hasRequiredFields()
        && pricingMatchesIntent();

      // No hard delete, and no setting status to 'removed' from the app
      // either: removing has to check for rental history first, so it goes
      // through the removeListing Cloud Function. History must survive.
      allow delete: if false;
    }

    // -----------------------------------------------------------------
    // posts — outfit looks
    // -----------------------------------------------------------------
    match /posts/{postId} {
      allow read: if signedIn();

      // Posts are created ONLY by the createPost function.
      //
      // Unlike a listing, a post reaches outside its own document: tagging
      // a garment bumps tagCount on that listing, and taggedListingIds has
      // to agree with the tags actually pinned to the photos. Rules cannot
      // do either, so there is one path and it is server-side.
      allow create: if false;

      // She may fix the caption and the occasions. Nothing else — the
      // photos carry the tags, and changing those has to move counters.
      allow update: if isActive()
        && resource.data.authorUid == uid()
        && onlyChanges(['caption', 'occasions', 'updatedAt'])
        && request.resource.data.caption is string
        && request.resource.data.caption.size() <= 1000
        && request.resource.data.occasions is list
        && request.resource.data.occasions.size() <= 8;

      // Taking a post down hands back the tag counts it was holding, so
      // that also goes through a function. Nothing is ever hard-deleted:
      // a post's likes and tap-throughs are evidence for whether the
      // social side drives rentals.
      allow delete: if false;
    }

    // -----------------------------------------------------------------
    // comments — what people say under a look
    //
    // Readable by any signed-in student; the app filters out the ones
    // whose status is not 'active'. Hiding them in rules instead would
    // mean the author of a removed comment could not see it was gone,
    // and it would cost a query filter on every read for no real gain
    // — a removed comment is untidy, not secret.
    //
    // WRITTEN ONLY BY FUNCTIONS. Two reasons, both of which rules
    // cannot cover: the count under the post has to move with the
    // comment, and the name and photo stamped on it have to really be
    // hers. If the app could write those, anyone could post a comment
    // signed by somebody else.
    // -----------------------------------------------------------------
    match /comments/{commentId} {
      allow read: if signedIn();
      allow write: if false;
    }

    // -----------------------------------------------------------------
    // Social edges — follows, likes, saves
    //
    // All written by Cloud Functions so the counters they drive stay
    // honest. The app calls a callable function instead of writing here.
    // -----------------------------------------------------------------
    match /follows/{followId} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /likes/{likeId} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /postSaves/{saveId} {
      allow read: if signedIn() && resource.data.uid == uid();
      allow write: if false;
    }

    match /saves/{saveId} {
      allow read: if signedIn() && resource.data.uid == uid();
      allow write: if false;
    }

    // -----------------------------------------------------------------
    // bookings — rentals and purchases
    //
    // THE APP CANNOT WRITE HERE AT ALL. Every booking is created and moved
    // through its statuses by Cloud Functions running inside transactions.
    // This is what makes double-booking impossible rather than unlikely.
    // -----------------------------------------------------------------
    match /bookings/{bookingId} {
      allow read: if signedIn()
        && (resource.data.renterUid == uid()
            || resource.data.lenderUid == uid()
            || isAdmin());
      allow write: if false;
    }

    // -----------------------------------------------------------------
    // reviews
    //
    // Written only by a Cloud Function, which checks the author actually
    // completed the booking she is reviewing. That check is the whole
    // difference between a real rating system and a decorative one.
    // -----------------------------------------------------------------
    match /reviews/{reviewId} {
      allow read: if signedIn() && (resource.data.isHidden == false || isAdmin());
      // Written only by writeReview, which checks that the author really
      // completed the rental she is rating. That check is the whole
      // difference between a rating system and a comment box.
      allow write: if false;
    }

    // -----------------------------------------------------------------
    // conversations + messages
    // -----------------------------------------------------------------
    match /conversations/{conversationId} {
      function isParticipant() {
        return signedIn() && uid() in resource.data.participantUids;
      }

      allow read: if isParticipant() || isAdmin();
      // Created by a Cloud Function so both participants' summaries and the
      // unread counters are set correctly.
      allow create: if false;
      // She may clear HER OWN unread badge and nothing else. The
      // diff check is what stops her zeroing the other person's count
      // or rewriting the last-message preview. Marking a thread read
      // happens constantly, so making it a round trip to a function
      // would be a lot of latency for one number.
      //
      // She may also stamp HER OWN "last had this open" time, which is
      // what shows "Seen" to the other person. Only her key, and only
      // the server's clock — so she cannot mark herself as having seen
      // something before it was sent, or claim someone else saw it.
      function validLastRead() {
        let after = request.resource.data.get('lastReadAt', {});
        let changedKeys = after.diff(resource.data.get('lastReadAt', {})).affectedKeys();
        return after is map
          && changedKeys.hasOnly([uid()])
          && (!(uid() in changedKeys) || after[uid()] == request.time);
      }

      // Deleting a thread from her inbox: HER OWN key only, on the
      // server's clock. Nothing is erased — the other person keeps her
      // copy and moderation can still see it.
      function validHidden() {
        let after = request.resource.data.get('hiddenAt', {});
        let changedKeys = after.diff(resource.data.get('hiddenAt', {})).affectedKeys();
        return after is map
          && changedKeys.hasOnly([uid()])
          && (!(uid() in changedKeys) || after[uid()] == request.time);
      }

      // Muting: she may add or remove herself and nobody else.
      function validMuted() {
        let after = request.resource.data.get('mutedUids', []);
        let before = resource.data.get('mutedUids', []).toSet();
        return after is list
          && after.size() <= 2
          && after.toSet().difference(before)
               .union(before.difference(after.toSet()))
               .hasOnly([uid()]);
      }

      // Her badge may be left alone, or cleared to zero — never anyone
      // else's, and never set to a number.
      function validUnread() {
        let changedKeys = request.resource.data.unreadCounts
             .diff(resource.data.unreadCounts)
             .affectedKeys();
        return changedKeys.size() == 0
          || (changedKeys.hasOnly([uid()]) && request.resource.data.unreadCounts[uid()] == 0);
      }

      allow update: if isParticipant()
        && onlyChanges(['unreadCounts', 'lastReadAt', 'hiddenAt', 'mutedUids', 'updatedAt'])
        && validUnread()
        && validLastRead()
        && validHidden()
        && validMuted();
      allow delete: if false;

      match /messages/{messageId} {
        function inThread() {
          return signedIn()
            && uid() in get(/databases/$(database)/documents/conversations/$(conversationId))
                          .data.participantUids;
        }

        allow read: if inThread() || isAdmin();

        // A reply carries a copy of the message it answers so the quote
        // shows even when the original is far up the thread. The copy
        // must match the real message word for word, in this same
        // thread, and the original must not have been taken down —
        // otherwise a reply could put words in the other person's mouth.
        function validReply() {
          let r = request.resource.data.replyTo;
          let path = /databases/$(database)/documents/conversations/$(conversationId)/messages/$(r.messageId);
          return r is map
            && r.keys().hasOnly(['messageId', 'senderUid', 'body', 'hasPhoto', 'hasSharedPost',
                                 'hasSharedListing'])
            && r.messageId is string
            && exists(path)
            && get(path).data.isDeleted == false
            && r.senderUid == get(path).data.senderUid
            && r.body == get(path).data.body
            && r.hasPhoto == (get(path).data.get('photo', null) != null)
            && r.hasSharedPost == (get(path).data.get('sharedPost', null) != null)
            // Optional: replies from before pieces could be shared lack it.
            && (!('hasSharedListing' in r)
                || r.hasSharedListing == (get(path).data.get('sharedListing', null) != null));
        }

        // Every message must move her hourly counter by exactly one in
        // the same batch — see messageQuotas. Either the count went up
        // by one, or a fresh window opened with this very request.
        function countedInQuota() {
          let q = /databases/$(database)/documents/messageQuotas/$(uid());
          let after = getAfter(q).data;
          return existsAfter(q)
            && ((exists(q) && after.count == get(q).data.count + 1)
                || (after.windowStart == request.time && after.count == 1));
        }

        // Neither person in this thread has blocked the other. Opening
        // a thread is already refused between blocked people (see
        // openConversation), but a thread that existed BEFORE the block
        // is still there, and messages are written straight from the
        // app — so without this, blocking someone would not stop her
        // messages. Two reads, both of tiny marker documents.
        function notBlockedInThread() {
          let p = get(/databases/$(database)/documents/conversations/$(conversationId))
                    .data.participantUids;
          return p.size() == 2
            && !exists(/databases/$(database)/documents/users/$(p[0])/blocked/$(p[1]))
            && !exists(/databases/$(database)/documents/users/$(p[1])/blocked/$(p[0]));
        }

        // A shared look or piece is written by the sharePost or
        // shareListing function, never by the app: the snapshot in the
        // bubble has to be the real thing. So an app-written message
        // must carry sharedPost == null and sharedListing == null.
        allow create: if inThread()
          && isVerifiedStudent()
          && notBlockedInThread()
          && countedInQuota()
          && request.resource.data.senderUid == uid()
          && request.resource.data.isDeleted == false
          && (!('sharedPost' in request.resource.data)
              || request.resource.data.sharedPost == null)
          && (!('sharedListing' in request.resource.data)
              || request.resource.data.sharedListing == null)
          && (!('replyTo' in request.resource.data)
              || request.resource.data.replyTo == null
              || validReply());

        // A heart on a message: she may add or take back her OWN heart
        // and nobody else's, and not on a message moderation took down.
        function validLike() {
          let after = request.resource.data.get('likedBy', []);
          let before = resource.data.get('likedBy', []).toSet();
          return after is list
            && after.size() <= 2
            && after.toSet().difference(before)
                 .union(before.difference(after.toSet()))
                 .hasOnly([uid()])
            && resource.data.isDeleted == false;
        }

        // She may mark a message read, or heart it; she may not edit
        // what was said.
        allow update: if inThread()
          && (onlyChanges(['readBy', 'updatedAt'])
              // A heart pings the other person's inbox, so it is
              // contact too — refused once either has blocked.
              || (onlyChanges(['likedBy', 'updatedAt']) && validLike() && notBlockedInThread()));
        allow delete: if false;
      }
    }

    // -----------------------------------------------------------------
    // Moderation — admin eyes only
    //
    // A reported user must never be able to see who reported her, so these
    // are not readable by the people involved.
    // -----------------------------------------------------------------
    match /reports/{reportId} {
      allow read: if isAdmin() || (signedIn() && resource.data.reporterUid == uid());
      allow write: if false;
    }

    match /supportRequests/{requestId} {
      allow read: if isAdmin() || (signedIn() && resource.data.requesterUid == uid());
      allow write: if false;
    }

    match /damageClaims/{claimId} {
      allow read: if isAdmin()
        || (signedIn() && (resource.data.lenderUid == uid() || resource.data.renterUid == uid()));
      allow write: if false;
    }

    match /adminActions/{actionId} {
      // Append-only audit log. Even admins cannot rewrite it.
      allow read: if isAdmin();
      allow write: if false;
    }

    // -----------------------------------------------------------------
    // events — engagement tracking
    //
    // Create-only from the app. Nobody reads these but admins. They are how
    // we answer the two MVP questions, so they must be tamper-proof: a
    // single motivated student able to write arbitrary rows can make
    // tagged_item_tap say whatever she likes, and we would go on to make
    // decisions on it.
    //
    // The two lists below mirror EVENT_TYPES and EVENT_SURFACES in
    // shared/src/constants.ts. Rules cannot import, so they are copied —
    // and a test in rules.test.ts fails if the two ever drift.
    //
    // NOT enforced here: how MANY events one person may write. Rules
    // cannot count over time. That needs App Check and rate limiting,
    // which are Phase 8. See docs/security.md.
    // -----------------------------------------------------------------
    match /events/{eventId} {
      function allowedType() {
        return request.resource.data.type in [
          'app_open', 'onboarding_step', 'signup_completed', 'profile_edit',
          'post_view', 'post_like', 'post_unlike', 'post_save', 'post_unsave',
          'post_create', 'post_edit', 'post_delete',
          'listing_view', 'listing_create', 'listing_edit', 'listing_remove',
          'save', 'unsave', 'tagged_item_tap',
          'profile_view', 'closet_view', 'follow', 'unfollow',
          'search', 'filter_used',
          'rental_requested', 'rental_confirmed', 'rental_declined',
          'rental_cancelled', 'rental_handoff', 'rental_received',
          'rental_returned', 'rental_disputed',
          'message_sent', 'comment_created', 'comment_deleted',
          'post_shared', 'listing_shared', 'invite_shared', 'review_written',
          'report_submitted', 'user_blocked', 'user_unblocked',
          'tryon_open', 'tryon_generate', 'tryon_save',
          'tryon_body_photo_set', 'tryon_body_photo_delete'
        ];
      }

      function allowedSurface() {
        return request.resource.data.surface in [
          'feed', 'discover', 'search', 'profile', 'closet', 'listing',
          'post', 'onboarding', 'activity', 'messages', 'tryon', 'other'
        ];
      }

      allow read: if isAdmin();

      allow create: if signedIn()
        // Hers, and honestly hers.
        && request.resource.data.uid == uid()
        // Her own campus. Otherwise one student can poison another
        // campus's numbers and we would never know which rows to
        // distrust. Costs one extra read per event; at a few hundred
        // users that is nothing, and it is the difference between
        // analytics we can act on and analytics we cannot.
        && request.resource.data.campusId == existingUser().campusId
        // The server's clock, not the phone's. A backdated event lands
        // in a week we have already reported on.
        && request.resource.data.createdAt == request.time
        && allowedType()
        && allowedSurface()
        && (request.resource.data.targetType == null
            || request.resource.data.targetType in
               ['post', 'listing', 'user', 'booking', 'search', 'screen'])
        && (request.resource.data.targetId == null
            || request.resource.data.targetId.size() <= 200)
        // meta carries a search term or a filter name, not a payload.
        && request.resource.data.meta is map
        && request.resource.data.meta.size() <= 12
        && request.resource.data.sessionId is string
        && request.resource.data.sessionId.size() <= 64
        && request.resource.data.platform in ['ios', 'android', 'web']
        && request.resource.data.appVersion is string
        && request.resource.data.appVersion.size() <= 32;

      allow update, delete: if false;
    }

    // -----------------------------------------------------------------
    // circles — designed, not built (Phase 3+)
    // -----------------------------------------------------------------
    match /circles/{circleId} {
      allow read: if signedIn();
      allow write: if false;

      match /members/{memberUid} {
        allow read: if signedIn();
        allow write: if false;
      }
    }

    // -----------------------------------------------------------------
    // Anything not named above is denied. New collections must be added
    // here deliberately rather than inheriting access by accident.
    // -----------------------------------------------------------------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
