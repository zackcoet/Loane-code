rules_version = '2';

// Loane Firestore security rules.
//
// The guiding rule: NEVER TRUST THE PHONE.
//
// A user may write her own profile, listings, posts and messages. Everything
// that involves money, trust, verification or counting is writable only by
// Cloud Functions (which use the Admin SDK and bypass these rules entirely).
//
// See docs/security.md for the reasoning behind each block.

service cloud.firestore {
  match /databases/{database}/documents {

    // -----------------------------------------------------------------
    // Helpers
    // -----------------------------------------------------------------

    function signedIn() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    function isSelf(userId) {
      return signedIn() && uid() == userId;
    }

    // Admin is a custom claim set by the server, never a database field —
    // a field is something someone might find a way to write.
    function isAdmin() {
      return signedIn() && request.auth.token.admin == true;
    }

    function existingUser() {
      return get(/databases/$(database)/documents/users/$(uid())).data;
    }

    // Is this account in good standing? Suspended users can read but not act.
    function isActive() {
      return signedIn() && existingUser().status == 'active';
    }

    // Campus-verified AND active. Today isVerified is set from the email
    // domain alone (see docs/security.md) — the check is wired up now so
    // that turning on real verification changes nothing here.
    function isVerifiedStudent() {
      return isActive() && existingUser().isVerified == true;
    }

    // Which fields is this write touching?
    function changed() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    // True when a write only touches fields from the allowed list.
    function onlyChanges(allowed) {
      return changed().hasOnly(allowed);
    }

    // -----------------------------------------------------------------
    // campuses — the approved-school list
    // -----------------------------------------------------------------
    match /campuses/{campusId} {
      // Readable by anyone, including signed-out users: the signup screen
      // needs the approved domain list before an account exists.
      allow read: if true;
      // Written only by Cloud Functions / admins.
      allow write: if false;
    }

    // -----------------------------------------------------------------
    // users — public profile
    // -----------------------------------------------------------------
    match /users/{userId} {
      allow read: if signedIn();

      // The user profile document is created by a Cloud Function during
      // signup, never by the app — it has to set campusId and isVerified.
      allow create: if false;

      // She may edit a narrow set of her own fields and nothing else.
      //
      // This is an ALLOW-LIST: anything not named here is refused, so a
      // field added to the User type later is locked by default until we
      // deliberately open it.
      //
      // Deliberately absent, and each for a reason:
      //   username        — a handle is a lock; changeUsername owns it
      //   campusId        — she cannot move herself to another school
      //   campusEmail     — the address is what her campus claim rests on
      //   isVerified      — otherwise "verified student" means nothing
      //   emailConfirmed  — only a real confirmation may set this
      //   role, status    — nobody promotes or un-suspends themselves
      //   stats           — every counter is a Cloud Function's job
      //   isFoundingCloset, stripe, verifiedAt, createdAt
      allow update: if isSelf(userId)
        && isActive()
        && onlyChanges([
             'firstName',
             'displayName',
             'bio',
             'photoUrl',
             'sizes',
             'pushTokens',
             'lastActiveAt',
             'updatedAt'
           ]);

      allow delete: if false;

      // Private settings: only hers, only ever read by her or an admin.
      match /private/{docId} {
        allow read: if isSelf(userId) || isAdmin();
        allow write: if isSelf(userId) && isActive();
      }

      // Who she has blocked. Written only by blockUser, so the reverse
      // marker below can never drift out of step with it.
      match /blocked/{blockedUid} {
        allow read: if isSelf(userId);
        allow write: if false;
      }

      // Who has blocked HER.
      //
      // She can read it, which technically tells her she was blocked.
      // Her app needs it to hide him from her feed — without it,
      // blocking would only work one way in practice. Nothing in the UI
      // ever says "you were blocked"; her app just quietly filters.
      // The honest version of this trade-off is in docs/security.md.
      match /blockedBy/{blockerUid} {
        allow read: if isSelf(userId);
        allow write: if false;
      }

      // Activity feed. Written by Cloud Functions; she may only mark read.
      match /notifications/{notificationId} {
        allow read: if isSelf(userId);
        allow create, delete: if false;
        allow update: if isSelf(userId) && onlyChanges(['readAt', 'updatedAt']);
      }
    }

    // -----------------------------------------------------------------
    // usernames — uniqueness locks
    // -----------------------------------------------------------------
    match /usernames/{username} {
      // Readable so the claim-username screen can say "already taken"
      // before submitting.
      allow read: if true;
      // Claiming happens in a Cloud Function transaction alongside the
      // user document. Letting the app write here would let someone claim
      // a name without taking it.
      allow write: if false;
    }

    // -----------------------------------------------------------------
    // listings — garments in closets
    //
    // These checks mirror `validateListingDraft` in shared/src/validation.ts.
    // The app's copy gives a friendly message; THIS copy is what makes it
    // true, because security rules cannot call TypeScript. If you change
    // one, change the other.
    // -----------------------------------------------------------------
    match /listings/{listingId} {
      function draft() {
        return request.resource.data;
      }

      function hasRequiredFields() {
        return draft().keys().hasAll([
                 'ownerUid', 'campusId', 'name', 'category', 'occasions',
                 'intent', 'status', 'photos', 'pricing', 'stats'
               ])
          && draft().name is string
          && draft().name.size() >= 2
          && draft().name.size() <= 80
          && draft().description is string
          && draft().description.size() <= 1000
          && draft().category in [
               'dresses','tops','bottoms','sets','outerwear',
               'shoes','bags','accessories','jewelry'
             ]
          && draft().occasions is list
          && draft().occasions.size() >= 1
          && draft().occasions.size() <= 8
          && draft().intent in ['rent', 'sell', 'both']
          && draft().photos is list
          && draft().photos.size() >= 1
          && draft().photos.size() <= 8;
      }

      /** A price, in whole cents, inside the allowed range. */
      function validPrice(cents) {
        return cents is int && cents >= 100 && cents <= 100000;
      }

      function pricingMatchesIntent() {
        return (
          // Rentable pieces need both durations priced and a documented
          // value — the value is what caps a damage claim later.
          !(draft().intent in ['rent', 'both'])
          || (validPrice(draft().pricing.threeDayCents)
              && validPrice(draft().pricing.sevenDayCents)
              && draft().garmentValueCents is int
              && draft().garmentValueCents >= 1000
              && draft().garmentValueCents <= 500000)
        ) && (
          !(draft().intent in ['sell', 'both']) || validPrice(draft().salePriceCents)
        );
      }

      function countersStartAtZero() {
        return draft().stats.viewCount == 0
          && draft().stats.saveCount == 0
          && draft().stats.tagCount == 0
          && draft().stats.completedRentals == 0;
      }

      allow read: if signedIn();

      allow create: if isVerifiedStudent()
        && draft().ownerUid == uid()
        && draft().campusId == existingUser().campusId
        && draft().status in ['draft', 'active']
        && hasRequiredFields()
        && pricingMatchesIntent()
        // She does not get to invent a view count.
        && countersStartAtZero();

      allow update: if isActive()
        && resource.data.ownerUid == uid()
        // She cannot move a listing to another campus, change its owner,
        // write its counters, or un-suspend it after an admin took it down.
        && !changed().hasAny([
             'ownerUid', 'campusId', 'stats', 'suspendedReason',
             'createdAt', 'owner', 'removedAt',
             // Derived from the bookings by a Cloud Function. If the app
             // could write it, a lender could hide a booked weekend.
             'bookedDates'
           ])
        && draft().status in ['draft', 'active', 'paused']
        && hasRequiredFields()
        && pricingMatchesIntent();

      // No hard delete, and no setting status to 'removed' from the app
      // either: removing has to check for rental history first, so it goes
      // through the removeListing Cloud Function. History must survive.
      allow delete: if false;
    }

    // -----------------------------------------------------------------
    // posts — outfit looks
    // -----------------------------------------------------------------
    match /posts/{postId} {
      allow read: if signedIn();

      // Posts are created ONLY by the createPost function.
      //
      // Unlike a listing, a post reaches outside its own document: tagging
      // a garment bumps tagCount on that listing, and taggedListingIds has
      // to agree with the tags actually pinned to the photos. Rules cannot
      // do either, so there is one path and it is server-side.
      allow create: if false;

      // She may fix the caption and the occasions. Nothing else — the
      // photos carry the tags, and changing those has to move counters.
      allow update: if isActive()
        && resource.data.authorUid == uid()
        && onlyChanges(['caption', 'occasions', 'updatedAt'])
        && request.resource.data.caption is string
        && request.resource.data.caption.size() <= 1000
        && request.resource.data.occasions is list
        && request.resource.data.occasions.size() <= 8;

      // Taking a post down hands back the tag counts it was holding, so
      // that also goes through a function. Nothing is ever hard-deleted:
      // a post's likes and tap-throughs are evidence for whether the
      // social side drives rentals.
      allow delete: if false;
    }

    // -----------------------------------------------------------------
    // Social edges — follows, likes, saves
    //
    // All written by Cloud Functions so the counters they drive stay
    // honest. The app calls a callable function instead of writing here.
    // -----------------------------------------------------------------
    match /follows/{followId} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /likes/{likeId} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /postSaves/{saveId} {
      allow read: if signedIn() && resource.data.uid == uid();
      allow write: if false;
    }

    match /saves/{saveId} {
      allow read: if signedIn() && resource.data.uid == uid();
      allow write: if false;
    }

    // -----------------------------------------------------------------
    // bookings — rentals and purchases
    //
    // THE APP CANNOT WRITE HERE AT ALL. Every booking is created and moved
    // through its statuses by Cloud Functions running inside transactions.
    // This is what makes double-booking impossible rather than unlikely.
    // -----------------------------------------------------------------
    match /bookings/{bookingId} {
      allow read: if signedIn()
        && (resource.data.renterUid == uid()
            || resource.data.lenderUid == uid()
            || isAdmin());
      allow write: if false;
    }

    // -----------------------------------------------------------------
    // reviews
    //
    // Written only by a Cloud Function, which checks the author actually
    // completed the booking she is reviewing. That check is the whole
    // difference between a real rating system and a decorative one.
    // -----------------------------------------------------------------
    match /reviews/{reviewId} {
      allow read: if signedIn() && (resource.data.isHidden == false || isAdmin());
      // Written only by writeReview, which checks that the author really
      // completed the rental she is rating. That check is the whole
      // difference between a rating system and a comment box.
      allow write: if false;
    }

    // -----------------------------------------------------------------
    // conversations + messages
    // -----------------------------------------------------------------
    match /conversations/{conversationId} {
      function isParticipant() {
        return signedIn() && uid() in resource.data.participantUids;
      }

      allow read: if isParticipant() || isAdmin();
      // Created by a Cloud Function so both participants' summaries and the
      // unread counters are set correctly.
      allow create: if false;
      // She may clear HER OWN unread badge and nothing else. The
      // diff check is what stops her zeroing the other person's count
      // or rewriting the last-message preview. Marking a thread read
      // happens constantly, so making it a round trip to a function
      // would be a lot of latency for one number.
      allow update: if isParticipant()
        && onlyChanges(['unreadCounts', 'updatedAt'])
        && request.resource.data.unreadCounts
             .diff(resource.data.unreadCounts)
             .affectedKeys()
             .hasOnly([uid()])
        && request.resource.data.unreadCounts[uid()] == 0;
      allow delete: if false;

      match /messages/{messageId} {
        function inThread() {
          return signedIn()
            && uid() in get(/databases/$(database)/documents/conversations/$(conversationId))
                          .data.participantUids;
        }

        allow read: if inThread() || isAdmin();

        allow create: if inThread()
          && isVerifiedStudent()
          && request.resource.data.senderUid == uid()
          && request.resource.data.isDeleted == false;

        // She may mark a message read; she may not edit what was said.
        allow update: if inThread() && onlyChanges(['readBy', 'updatedAt']);
        allow delete: if false;
      }
    }

    // -----------------------------------------------------------------
    // Moderation — admin eyes only
    //
    // A reported user must never be able to see who reported her, so these
    // are not readable by the people involved.
    // -----------------------------------------------------------------
    match /reports/{reportId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /damageClaims/{claimId} {
      allow read: if isAdmin()
        || (signedIn() && (resource.data.lenderUid == uid() || resource.data.renterUid == uid()));
      allow write: if false;
    }

    match /adminActions/{actionId} {
      // Append-only audit log. Even admins cannot rewrite it.
      allow read: if isAdmin();
      allow write: if false;
    }

    // -----------------------------------------------------------------
    // events — engagement tracking
    //
    // Create-only from the app. Nobody reads these but admins. They are how
    // we answer the two MVP questions, so they must be tamper-proof.
    // -----------------------------------------------------------------
    match /events/{eventId} {
      allow read: if isAdmin();
      allow create: if signedIn()
        && request.resource.data.uid == uid();
      allow update, delete: if false;
    }

    // -----------------------------------------------------------------
    // circles — designed, not built (Phase 3+)
    // -----------------------------------------------------------------
    match /circles/{circleId} {
      allow read: if signedIn();
      allow write: if false;

      match /members/{memberUid} {
        allow read: if signedIn();
        allow write: if false;
      }
    }

    // -----------------------------------------------------------------
    // Anything not named above is denied. New collections must be added
    // here deliberately rather than inheriting access by accident.
    // -----------------------------------------------------------------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
