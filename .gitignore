# Dependencies
node_modules/
.pnp/
.pnp.js

# Environment / secrets
.env
.env.*
!.env.example
*.pem
serviceAccountKey*.json
google-services.json
GoogleService-Info.plist

# Build output.
#
# These are anchored to the directories that actually produce build
# output. A bare `lib/` matches a directory called lib at ANY depth,
# which silently swallowed mobile/src/lib and backend/functions/src/lib
# — real source that had never been committed. Everything worked on
# this laptop and the first EAS build died on "Unable to resolve module
# ../../src/lib/photo". Keep these anchored.
dist/
build/
/backend/functions/lib/
/shared/lib/
*.tsbuildinfo
.vite/

# Expo
.expo/
.expo-shared/
*.jks
*.p8
*.p12
*.mobileprovision
*.orig.*
web-build/
ios/
android/

# Firebase
.firebase/
firebase-debug.log
firebase-debug.*.log
firestore-debug.log
ui-debug.log
database-debug.log
pubsub-debug.log
*.log
.runtimeconfig.json
emulator-data/

# Editors / OS
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json
*.swp

# Test / coverage
coverage/

# Throwaway diagnostic scripts. Anything under scripts/ starting with an
# underscore is a one-off written to poke at a live project — they hold
# ad-hoc queries and sometimes real ids, and none of them belong in the
# repo. The committed scripts next to them have real names.
backend/functions/scripts/_*.ts
