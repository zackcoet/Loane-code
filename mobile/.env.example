# Loane mobile app configuration.
# Copy this to `.env` and fill it in. NEVER commit `.env`.
#
# Note: the Firebase web config is NOT a secret. It identifies the project;
# it does not grant access — the security rules do that. It is safe in a
# shipped app. We keep it in .env anyway so dev and production can differ.

# --- Which backend to talk to ---------------------------------------------
# true  = the local Firebase Emulator Suite (what you want while building)
# false = the real Firebase project named below
EXPO_PUBLIC_USE_EMULATORS=true

# LEAVE THIS BLANK unless you know you need it.
#
# The app works out your laptop's address from the Metro dev server it
# already connected to, which is by definition an address your phone can
# reach — and it follows you when you change networks.
#
# Only set this when the emulators are running somewhere OTHER than the
# machine running Metro. A stale value here silently overrides the
# detection and is the usual cause of "no connection" on a real phone.
EXPO_PUBLIC_EMULATOR_HOST=

# --- Firebase web config ---------------------------------------------------
# Firebase console → Project settings → Your apps → Web app.
# With emulators on, dummy values are fine — that is why these defaults work
# out of the box.
EXPO_PUBLIC_FIREBASE_API_KEY=demo-api-key
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=demo-loane.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=demo-loane
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=demo-loane.firebasestorage.app
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000
EXPO_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000
